tensor<T> convolve2d<T: numeric>(
    tensor<T> pixels,
    tensor<T> kernel,
    int padding
)
    int[] shape = int(pixels.shape())
    int height_axis = int(len(shape)) - 2
    int width_axis = int(len(shape)) - 1
    int height = shape[height_axis]
    int width = shape[width_axis]
    int[] kernel_shape = int(kernel.shape())
    int kernel_height = kernel_shape[0]
    int kernel_width = kernel_shape[1]

    int planes = 1
    for axis in range(height_axis)
        planes = planes * shape[axis]

    int padded_height = height + padding * 2
    int padded_width = width + padding * 2
    int[] padded_shape = shape
    padded_shape[height_axis] = padded_height
    padded_shape[width_axis] = padded_width

    int input_count = planes * height * width
    int[] padded_indices = array(nat(input_count), fill = 0)
    for flat_index in range(input_count)
        int x = flat_index % width
        int remaining = flat_index / width
        int y = remaining % height
        int plane = remaining / height
        padded_indices[flat_index] = (
            (plane * padded_height + padding + y) * padded_width
            + padding + x
        )

    // Core supplies only tensor/autograd substrate. Vision owns the image-domain
    // patch mapping and the convolution contraction itself.
    tensor<T> padded = pixels.scatter(padded_indices, nat(padded_shape))

    int output_height = padded_height - kernel_height + 1
    int output_width = padded_width - kernel_width + 1
    int kernel_count = kernel_height * kernel_width
    int patch_rows = planes * output_height * output_width
    int patch_count = patch_rows * kernel_count
    int[] patch_indices = array(nat(patch_count), fill = 0)

    for flat_index in range(patch_count)
        int patch_column = flat_index % kernel_count
        int patch_row = flat_index / kernel_count

        int kernel_x = patch_column % kernel_width
        int kernel_y = patch_column / kernel_width
        int source_kernel_x = kernel_width - 1 - kernel_x
        int source_kernel_y = kernel_height - 1 - kernel_y

        int output_x = patch_row % output_width
        int output_remaining = patch_row / output_width
        int output_y = output_remaining % output_height
        int plane = output_remaining / output_height

        int source_y = output_y + source_kernel_y
        int source_x = output_x + source_kernel_x
        patch_indices[flat_index] = (
            (plane * padded_height + source_y) * padded_width + source_x
        )

    tensor<T> patches = padded.gather(
        patch_indices, [nat(patch_rows), nat(kernel_count)]
    )
    tensor<T> flat_kernel = kernel.reshape([nat(kernel_count)])

    // Contract each patch row with the kernel using only domain-neutral tensor
    // primitives. This keeps Vision independent of Core linear algebra while
    // preserving the differentiable graph for floating-point tensors.
    int[] first_patch_indices = array(nat(patch_rows), fill = 0)
    int[] first_kernel_indices = array(nat(patch_rows), fill = 0)
    for patch_row in range(patch_rows)
        first_patch_indices[patch_row] = patch_row * kernel_count
    tensor<T> result = (
        patches.gather(first_patch_indices, [nat(patch_rows)])
        * flat_kernel.gather(first_kernel_indices, [nat(patch_rows)])
    )

    for remaining_column in range(kernel_count - 1)
        int patch_column = remaining_column + 1
        int[] column_patch_indices = array(nat(patch_rows), fill = 0)
        int[] column_kernel_indices = array(nat(patch_rows), fill = patch_column)
        for patch_row in range(patch_rows)
            column_patch_indices[patch_row] = (
                patch_row * kernel_count + patch_column
            )
        result = result + (
            patches.gather(column_patch_indices, [nat(patch_rows)])
            * flat_kernel.gather(column_kernel_indices, [nat(patch_rows)])
        )

    int[] output_shape = shape
    output_shape[height_axis] = output_height
    output_shape[width_axis] = output_width
    return result.reshape(nat(output_shape))

tensor<T> zeros_on<T: numeric>(int[] shape, int device)
    if device >= 0
        return tensor.zeros<T>(nat(shape), gpu = nat(device))
    return tensor.zeros<T>(nat(shape))

// Portable block sums for vision.downsample_mean: every complete
// factor x factor block of the trailing H, W axes, built from Core gather and
// add only, so it runs on any device and keeps the autograd graph. Each block
// row is summed left to right, then the row sums top to bottom - the order the
// native kernels use - and trailing rows/columns outside every block are never
// read.
tensor<T> block_sum<T: numeric>(tensor<T> pixels, int factor)
    int[] shape = int(pixels.shape())
    int height_axis = int(len(shape)) - 2
    int width_axis = int(len(shape)) - 1
    int height = shape[height_axis]
    int width = shape[width_axis]
    int output_height = height / factor
    int output_width = width / factor
    int covered_height = output_height * factor
    int planes = 1
    for axis in range(height_axis)
        planes = planes * shape[axis]

    // Horizontal pass: [planes, covered_height, output_width] run sums.
    int run_count = planes * covered_height * output_width
    int[] run_starts = array(nat(run_count), fill = 0)
    for flat_index in range(run_count)
        int ox = flat_index % output_width
        int remaining = flat_index / output_width
        int y = remaining % covered_height
        int plane = remaining / covered_height
        run_starts[flat_index] = (plane * height + y) * width + ox * factor
    tensor<T> runs = pixels.gather(run_starts, [run_count])
    int[] run_indices = array(nat(run_count), fill = 0)
    for dx in range(1, factor)
        for flat_index in range(run_count)
            run_indices[flat_index] = run_starts[flat_index] + dx
        runs = runs + pixels.gather(run_indices, [run_count])

    // Vertical pass over the run sums of each block.
    int[] output_shape = shape
    output_shape[height_axis] = output_height
    output_shape[width_axis] = output_width
    int output_count = planes * output_height * output_width
    int[] block_tops = array(nat(output_count), fill = 0)
    for flat_index in range(output_count)
        int ox = flat_index % output_width
        int remaining = flat_index / output_width
        int oy = remaining % output_height
        int plane = remaining / output_height
        block_tops[flat_index] = (
            (plane * covered_height + oy * factor) * output_width + ox
        )
    tensor<T> total = runs.gather(block_tops, nat(output_shape))
    int[] block_rows = array(nat(output_count), fill = 0)
    for dy in range(1, factor)
        for flat_index in range(output_count)
            block_rows[flat_index] = block_tops[flat_index] + dy * output_width
        total = total + runs.gather(block_rows, nat(output_shape))
    return total

// factor * factor as a T scalar, exact whenever T can represent it.
T block_size<T: floating>(int count)
    T result = 0.0
    T power = 1.0
    int remaining = count
    while remaining > 0
        if remaining % 2 == 1
            result = result + power
        remaining = remaining / 2
        if remaining > 0
            power = power + power
    return result

// How vision.downsample_mean treats a nonzero native status
// (native/vision_native.cpp BlockStatus). The portable composition runs only
// where no Vision kernel can: no kernel for the dtype (2), no host storage lent
// by Core (5 - on the CPU an uninitialized element, which the composition then
// reports as Core's UNINITIALIZED), or no kernel for the backend or tensor size
// (6). Every other status is returned as an error from block_native_problem.
bool block_native_unavailable(int32 status)
    return status == int32(2) or status == int32(5) or status == int32(6)

string block_native_problem(int32 status)
    if status == int32(9)
        return "vision.downsample_mean does not support float64 tensors on Metal, which has no float64 arithmetic; convert to real32 or move the tensor to the CPU explicitly"
    if status == int32(7)
        return "vision.downsample_mean device kernel failed"
    if status == int32(8)
        return "vision.downsample_mean could not attach its autograd node"
    return "vision.downsample_mean native kernel rejected its arguments (status {status})"

// Portable floating block mean: the block sums divided once by
// factor * factor. This is the vision.downsample_mean path for backends and
// sizes without a Vision kernel (CUDA, HIP, tensors beyond the Metal kernels'
// 32-bit dispatch).
tensor<T> block_mean<T: floating>(tensor<T> pixels, int factor)
    return block_sum<T>(pixels, factor) / block_size<T>(factor * factor)

// Portable nat8 block mean: exact integer block sums, truncating quotient.
tensor<nat8> | error block_mean_u8(tensor<nat8> pixels, int factor)
    tensor<int64> totals = block_sum<int64>(int64(pixels), factor)
    tensor<nat8> means = try nat8(totals / (factor * factor))
    return means

// A contiguous copy of a tracked view in its logical element order. Core's
// contiguous() requires an untracked tensor, so the copy is one Core gather,
// which keeps the autograd graph and stays on the input device.
tensor<T> dense_copy<T: numeric>(tensor<T> pixels)
    int[] copy_shape = int(pixels.shape())
    int element_count = 1
    for axis_extent in copy_shape
        element_count = element_count * axis_extent
    int[] logical_order = array(nat(element_count), fill = 0)
    for logical_position in range(element_count)
        logical_order[logical_position] = logical_position
    return pixels.gather(logical_order, copy_shape)
