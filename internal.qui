tensor<T> convolve2d<T: numeric>(
    tensor<T> pixels,
    tensor<T> kernel,
    int padding
)
    shape := int(pixels.shape())
    height_axis := int(#shape) - 2
    width_axis := int(#shape) - 1
    height := shape[height_axis]
    width := shape[width_axis]
    kernel_shape := int(kernel.shape())
    kernel_height := kernel_shape[0]
    kernel_width := kernel_shape[1]

    planes := 1
    for: 0 <= int axis < height_axis
        planes = planes * shape[axis]

    padded_height := height + padding * 2
    padded_width := width + padding * 2
    padded_shape := shape
    padded_shape[height_axis] = padded_height
    padded_shape[width_axis] = padded_width

    input_count := planes * height * width
    padded_indices := array(nat(input_count), fill = 0)
    for: 0 <= int flat_index < input_count
        x := flat_index % width
        remaining := flat_index / width
        y := remaining % height
        plane := remaining / height
        padded_indices[flat_index] = (
            (plane * padded_height + padding + y) * padded_width
            + padding + x
        )

    // Core supplies only tensor/autograd substrate. Vision owns the image-domain
    // patch mapping and the convolution contraction itself.
    padded := pixels.scatter(padded_indices, padded_shape)

    output_height := padded_height - kernel_height + 1
    output_width := padded_width - kernel_width + 1
    kernel_count := kernel_height * kernel_width
    patch_rows := planes * output_height * output_width
    patch_count := patch_rows * kernel_count
    patch_indices := array(nat(patch_count), fill = 0)

    for: 0 <= int flat_index < patch_count
        patch_column := flat_index % kernel_count
        patch_row := flat_index / kernel_count

        kernel_x := patch_column % kernel_width
        kernel_y := patch_column / kernel_width
        source_kernel_x := kernel_width - 1 - kernel_x
        source_kernel_y := kernel_height - 1 - kernel_y

        output_x := patch_row % output_width
        output_remaining := patch_row / output_width
        output_y := output_remaining % output_height
        plane := output_remaining / output_height

        source_y := output_y + source_kernel_y
        source_x := output_x + source_kernel_x
        patch_indices[flat_index] = (
            (plane * padded_height + source_y) * padded_width + source_x
        )

    patches := padded.gather(
        patch_indices, [patch_rows, kernel_count]
    )
    flat_kernel := kernel.reshape([nat(kernel_count)])

    // Contract each patch row with the kernel using only domain-neutral tensor
    // primitives. This keeps Vision independent of Core linear algebra while
    // preserving the differentiable graph for floating-point tensors.
    first_patch_indices := array(nat(patch_rows), fill = 0)
    first_kernel_indices := array(nat(patch_rows), fill = 0)
    for: 0 <= int patch_row < patch_rows
        first_patch_indices[patch_row] = patch_row * kernel_count
    result := (
        patches.gather(first_patch_indices, [patch_rows])
        * flat_kernel.gather(first_kernel_indices, [patch_rows])
    )

    for: 0 <= int remaining_column < kernel_count - 1
        patch_column := remaining_column + 1
        column_patch_indices := array(nat(patch_rows), fill = 0)
        column_kernel_indices := array(nat(patch_rows), fill = patch_column)
        for: 0 <= int patch_row < patch_rows
            column_patch_indices[patch_row] = (
                patch_row * kernel_count + patch_column
            )
        result = result + (
            patches.gather(column_patch_indices, [patch_rows])
            * flat_kernel.gather(column_kernel_indices, [patch_rows])
        )

    output_shape := shape
    output_shape[height_axis] = output_height
    output_shape[width_axis] = output_width
    return result.reshape(nat(output_shape))

// Output storage for a Vision kernel that stores every element. On a device
// it is allocated without a fill: the kernel takes it write-only
// (qcore_tensor_output_handle) and marks it written. CPU outputs stay zeroed,
// because Core's CPU accessors lend only initialized storage.
tensor<T> native_output<T: numeric>(int[] shape, int device)
    if device >= 0
        return tensor<T>(nat(shape), gpu = nat(device))
    return tensor.zeros<T>(nat(shape))

// Portable block sums for vision.downsample_mean: every complete
// factor x factor block of the trailing H, W axes, built from Core gather and
// add only, so it runs on any device and keeps the autograd graph. Each block
// row is summed left to right, then the row sums top to bottom - the order the
// native kernels use - and trailing rows/columns outside every block are never
// read.
tensor<T> block_sum<T: numeric>(tensor<T> pixels, int factor)
    shape := int(pixels.shape())
    height_axis := int(#shape) - 2
    width_axis := int(#shape) - 1
    height := shape[height_axis]
    width := shape[width_axis]
    output_height := height / factor
    output_width := width / factor
    covered_height := output_height * factor
    planes := 1
    for: 0 <= int axis < height_axis
        planes = planes * shape[axis]

    // Horizontal pass: [planes, covered_height, output_width] run sums.
    run_count := planes * covered_height * output_width
    run_starts := array(nat(run_count), fill = 0)
    for: 0 <= int flat_index < run_count
        ox := flat_index % output_width
        remaining := flat_index / output_width
        y := remaining % covered_height
        plane := remaining / covered_height
        run_starts[flat_index] = (plane * height + y) * width + ox * factor
    runs := pixels.gather(run_starts, [run_count])
    run_indices := array(nat(run_count), fill = 0)
    for: 1 <= int dx < factor
        for: 0 <= int flat_index < run_count
            run_indices[flat_index] = run_starts[flat_index] + dx
        runs = runs + pixels.gather(run_indices, [run_count])

    // Vertical pass over the run sums of each block.
    output_shape := shape
    output_shape[height_axis] = output_height
    output_shape[width_axis] = output_width
    output_count := planes * output_height * output_width
    block_tops := array(nat(output_count), fill = 0)
    for: 0 <= int flat_index < output_count
        ox := flat_index % output_width
        remaining := flat_index / output_width
        oy := remaining % output_height
        plane := remaining / output_height
        block_tops[flat_index] = (
            (plane * covered_height + oy * factor) * output_width + ox
        )
    total := runs.gather(block_tops, output_shape)
    block_rows := array(nat(output_count), fill = 0)
    for: 1 <= int dy < factor
        for: 0 <= int flat_index < output_count
            block_rows[flat_index] = block_tops[flat_index] + dy * output_width
        total = total + runs.gather(block_rows, output_shape)
    return total

// factor * factor as a T scalar, exact whenever T can represent it.
T block_size<T: floating>(int count)
    T result := 0.0
    T power := 1.0
    remaining := count
    while remaining > 0
        if remaining % 2 == 1
            result = result + power
        remaining = remaining / 2
        if remaining > 0
            power = power + power
    return result

// How vision.downsample_mean treats a nonzero native status
// (native/vision_native.cpp BlockStatus). The portable composition runs only
// where no Vision kernel can: no kernel for the dtype (2), no storage lent by
// Core (5 - on every backend exactly when an element of the input is
// uninitialized, which the composition then reports as Core's UNINITIALIZED),
// or no kernel for the backend or tensor size (6). Every other status is
// returned as an error from block_native_problem.
bool block_native_unavailable(int32 status)
    return status == 2 or status == 5 or status == 6

string block_native_problem(int32 status)
    if status == 9
        return "vision.downsample_mean does not support real64 tensors on Metal, which has no real64 arithmetic; convert to real32 or move the tensor to the CPU explicitly"
    if status == 7
        return "vision.downsample_mean device kernel failed"
    if status == 8
        return "vision.downsample_mean could not attach its autograd node"
    return "vision.downsample_mean native kernel rejected its arguments (status {status})"

// Portable floating block mean: the block sums divided once by
// factor * factor. This is the vision.downsample_mean path for backends and
// sizes without a Vision kernel (CUDA, HIP, tensors beyond the Metal kernels'
// 32-bit dispatch).
tensor<T> block_mean<T: floating>(tensor<T> pixels, int factor)
    return block_sum<T>(pixels, factor) / block_size<T>(factor * factor)

// Portable nat8 block mean: exact integer block sums, truncating quotient.
tensor<nat8> | error block_mean_u8(tensor<nat8> pixels, int factor)
    totals := block_sum<int64>(int64(pixels), factor)
    fixed_factor := int64(factor)
    means := try nat8(totals / (fixed_factor * fixed_factor))
    return means

// A contiguous copy of a tracked view in its logical element order. Core's
// contiguous() requires an untracked tensor, so the copy is one Core gather,
// which keeps the autograd graph and stays on the input device.
tensor<T> dense_copy<T: numeric>(tensor<T> pixels)
    copy_shape := int(pixels.shape())
    element_count := 1
    for axis_extent := copy_shape[]
        element_count = element_count * axis_extent
    logical_order := array(nat(element_count), fill = 0)
    for: 0 <= int logical_position < element_count
        logical_order[logical_position] = logical_position
    return pixels.gather(logical_order, copy_shape)
