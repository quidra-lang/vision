tensor<T> | error crop<T>(
    tensor<T> pixels,
    int top,
    int left,
    int height,
    int width
)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.crop requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.crop requires positive CHW dimensions")
    if top < 0 or left < 0 or height <= 0 or width <= 0
        return error("vision.crop requires nonnegative origin and positive size")
    if top >= shape[1] or left >= shape[2]
        return error("vision.crop origin is outside the image")
    if height > shape[1] - top or width > shape[2] - left
        return error("vision.crop rectangle exceeds the image")
    tensor<T> result = tensor.zeros<T>([shape[0], height, width])
    for channel in range(shape[0])
        for y in range(height)
            for x in range(width)
                result[channel, y, x] = pixels[channel, top + y, left + x].item()
    return result

tensor<T> | error resize<T>(tensor<T> pixels, int height, int width)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.resize requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.resize requires positive CHW dimensions")
    if height <= 0 or width <= 0
        return error("vision.resize requires positive output dimensions")
    tensor<T> result = tensor.zeros<T>([shape[0], height, width])
    for channel in range(shape[0])
        for y in range(height)
            int source_y = y * shape[1] / height
            for x in range(width)
                int source_x = x * shape[2] / width
                result[channel, y, x] = pixels[channel, source_y, source_x].item()
    return result

tensor<T> | error flip_horizontal<T>(tensor<T> pixels)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.flip_horizontal requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.flip_horizontal requires positive CHW dimensions")
    tensor<T> result = tensor.zeros<T>(shape)
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                result[channel, y, x] = pixels[
                    channel, y, shape[2] - 1 - x
                ].item()
    return result

tensor<T> | error flip_vertical<T>(tensor<T> pixels)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.flip_vertical requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.flip_vertical requires positive CHW dimensions")
    tensor<T> result = tensor.zeros<T>(shape)
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                result[channel, y, x] = pixels[
                    channel, shape[1] - 1 - y, x
                ].item()
    return result

tensor<T> | error rotate90<T>(tensor<T> pixels)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.rotate90 requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.rotate90 requires positive CHW dimensions")
    tensor<T> result = tensor.zeros<T>([shape[0], shape[2], shape[1]])
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                result[channel, x, shape[1] - 1 - y] = pixels[channel, y, x].item()
    return result

tensor<T> | error rotate180<T>(tensor<T> pixels)
    tensor<T> horizontal = try flip_horizontal(pixels)
    return flip_vertical(horizontal)

tensor<T> | error rotate270<T>(tensor<T> pixels)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.rotate270 requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.rotate270 requires positive CHW dimensions")
    tensor<T> result = tensor.zeros<T>([shape[0], shape[2], shape[1]])
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                result[channel, shape[2] - 1 - x, y] = pixels[channel, y, x].item()
    return result

tensor<uint8> | error grayscale(tensor<uint8> pixels)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.grayscale requires a rank-3 CHW tensor")
    if shape[1] <= 0 or shape[2] <= 0
        return error("vision.grayscale requires positive spatial dimensions")
    if shape[0] != 1 and shape[0] != 3 and shape[0] != 4
        return error("vision.grayscale requires 1, 3, or 4 channels")
    tensor<uint8> result = tensor.zeros<uint8>([1, shape[1], shape[2]])
    for y in range(shape[1])
        for x in range(shape[2])
            if shape[0] == 1
                result[0, y, x] = pixels[0, y, x].item()
            else
                float red = float(pixels[0, y, x].item())
                float green = float(pixels[1, y, x].item())
                float blue = float(pixels[2, y, x].item())
                float luminance = 0.299 * red + 0.587 * green + 0.114 * blue
                result[0, y, x] = uint8(math.round(luminance))
    return result

tensor<uint8> | error threshold(
    tensor<uint8> pixels,
    uint8 cutoff,
    uint8 low = uint8(0),
    uint8 high = uint8(255)
)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.threshold requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.threshold requires positive CHW dimensions")
    tensor<uint8> result = tensor.zeros<uint8>(shape)
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                if pixels[channel, y, x].item() >= cutoff
                    result[channel, y, x] = high
                else
                    result[channel, y, x] = low
    return result

tensor<uint8> | error blur(tensor<uint8> pixels, int radius = 1)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.blur requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.blur requires positive CHW dimensions")
    if radius < 0
        return error("vision.blur radius must be nonnegative")
    tensor<uint8> result = tensor.zeros<uint8>(shape)
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                int total = 0
                int count = 0
                for offset_y in range(0 - radius, radius + 1)
                    int source_y = y + offset_y
                    if source_y >= 0 and source_y < shape[1]
                        for offset_x in range(0 - radius, radius + 1)
                            int source_x = x + offset_x
                            if source_x >= 0 and source_x < shape[2]
                                total += int(pixels[channel, source_y, source_x].item())
                                count += 1
                result[channel, y, x] = uint8(total / count)
    return result

tensor<uint8> | error filter(
    tensor<uint8> pixels,
    tensor<int> kernel,
    int divisor = 1,
    int offset = 0
)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.filter requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.filter requires positive CHW dimensions")
    if divisor == 0
        return error("vision.filter divisor must not be zero")
    int[] kernel_shape = kernel.shape()
    if len(kernel_shape) != 2
        return error("vision.filter requires a rank-2 kernel")
    if kernel_shape[0] <= 0 or kernel_shape[1] <= 0
        return error("vision.filter requires positive kernel dimensions")
    int center_y = kernel_shape[0] / 2
    int center_x = kernel_shape[1] / 2
    tensor<uint8> result = tensor.zeros<uint8>(shape)
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                int total = 0
                for kernel_y in range(kernel_shape[0])
                    int source_y = y + kernel_y - center_y
                    if source_y >= 0 and source_y < shape[1]
                        for kernel_x in range(kernel_shape[1])
                            int source_x = x + kernel_x - center_x
                            if source_x >= 0 and source_x < shape[2]
                                total += int(pixels[channel, source_y, source_x].item()) * kernel[kernel_y, kernel_x].item()
                int value = total / divisor + offset
                if value < 0
                    value = 0
                if value > 255
                    value = 255
                result[channel, y, x] = uint8(value)
    return result

tensor<T> | error dilate<T>(tensor<T> pixels, int radius = 1)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.dilate requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.dilate requires positive CHW dimensions")
    if radius < 0
        return error("vision.dilate radius must be nonnegative")
    tensor<T> result = tensor.zeros<T>(shape)
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                T maximum = pixels[channel, y, x].item()
                for offset_y in range(0 - radius, radius + 1)
                    int source_y = y + offset_y
                    if source_y >= 0 and source_y < shape[1]
                        for offset_x in range(0 - radius, radius + 1)
                            int source_x = x + offset_x
                            if source_x >= 0 and source_x < shape[2]
                                T candidate = pixels[channel, source_y, source_x].item()
                                if candidate > maximum
                                    maximum = candidate
                result[channel, y, x] = maximum
    return result

tensor<T> | error erode<T>(tensor<T> pixels, int radius = 1)
    int[] shape = pixels.shape()
    if len(shape) != 3
        return error("vision.erode requires a rank-3 CHW tensor")
    if shape[0] <= 0 or shape[1] <= 0 or shape[2] <= 0
        return error("vision.erode requires positive CHW dimensions")
    if radius < 0
        return error("vision.erode radius must be nonnegative")
    tensor<T> result = tensor.zeros<T>(shape)
    for channel in range(shape[0])
        for y in range(shape[1])
            for x in range(shape[2])
                T minimum = pixels[channel, y, x].item()
                for offset_y in range(0 - radius, radius + 1)
                    int source_y = y + offset_y
                    if source_y >= 0 and source_y < shape[1]
                        for offset_x in range(0 - radius, radius + 1)
                            int source_x = x + offset_x
                            if source_x >= 0 and source_x < shape[2]
                                T candidate = pixels[channel, source_y, source_x].item()
                                if candidate < minimum
                                    minimum = candidate
                result[channel, y, x] = minimum
    return result
