import math
import native = "./native.qui"
import internal = "./internal.qui"

tensor<T> | error read<T: numeric>(
    string path,
    channels := 0
)
    if channels != 0 and channels != 1 and channels != 3 and channels != 4
        return error("vision.read channels must be 0, 1, 3, or 4", code = "VISION_ARGUMENT")
    handle := native.image_open(path, int64(channels))
    if handle == nat64(0)
        return error("vision.read failed to decode the image", code = "VISION_DECODE")
    channel_count := int(native.image_channels(handle))
    height := int(native.image_height(handle))
    width := int(native.image_width(handle))
    if channel_count <= 0 or height <= 0 or width <= 0
        native.image_close(handle)
        return error("vision.read received invalid image metadata", code = "VISION_DECODE")
    output := tensor.zeros<T>([nat(channel_count), nat(height), nat(width)])
    status := native.image_fill<T>(handle, &output)
    native.image_close(handle)
    if status != 0
        return error("vision.read failed to materialize the decoded image", code = "VISION_DECODE")
    return output

void | error write<T: numeric>(
    string path,
    tensor<T> pixels,
    quality := 90
)
    if quality < 1 or quality > 100
        return error("vision.write quality must be between 1 and 100", code = "VISION_ARGUMENT")
    shape := int(pixels.shape())
    if len(shape) != 3
        return error("vision.write requires a rank-3 CHW tensor", code = "VISION_SHAPE")
    if shape[0] != 1 and shape[0] != 3 and shape[0] != 4
        return error("vision.write requires 1, 3, or 4 channels", code = "VISION_SHAPE")
    if not pixels.is_contiguous()
        return error("vision.write requires a contiguous tensor", code = "VISION_SHAPE")
    status := native.image_write<T>(path, pixels, int64(quality))
    if status != 0
        return error("vision.write failed; image codecs require a CPU tensor and a supported file extension", code = "VISION_ENCODE")
    return

tensor<T> | error crop<T>(
    tensor<T> pixels,
    int top,
    int left,
    int height,
    int width
)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.crop requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.crop requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    input_height := shape[height_axis]
    input_width := shape[width_axis]
    if top < 0 or left < 0 or height <= 0 or width <= 0
        return error("vision.crop requires nonnegative origin and positive size", code = "VISION_ARGUMENT")
    if top >= input_height or left >= input_width
        return error("vision.crop origin is outside the image", code = "VISION_SHAPE")
    if height > input_height - top or width > input_width - left
        return error("vision.crop rectangle exceeds the image", code = "VISION_SHAPE")
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    output_shape := shape
    output_shape[height_axis] = height
    output_shape[width_axis] = width
    output_count := planes * height * width
    int[] indices := array(nat(output_count), fill = 0)
    for 0 <= int flat_index < output_count
        x := flat_index % width
        y := (flat_index / width) % height
        plane := flat_index / (height * width)
        indices[flat_index] = (plane * input_height + top + y) * input_width + left + x
    return pixels.gather(indices, output_shape)

tensor<T> | error resize<T>(tensor<T> pixels, int height, int width)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.resize requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.resize requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if height <= 0 or width <= 0
        return error("vision.resize requires positive output dimensions", code = "VISION_ARGUMENT")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    input_height := shape[height_axis]
    input_width := shape[width_axis]
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    output_shape := shape
    output_shape[height_axis] = height
    output_shape[width_axis] = width
    output_count := planes * height * width
    int[] indices := array(nat(output_count), fill = 0)
    for 0 <= int flat_index < output_count
        x := flat_index % width
        y := (flat_index / width) % height
        plane := flat_index / (height * width)
        source_y := y * input_height / height
        source_x := x * input_width / width
        indices[flat_index] = (plane * input_height + source_y) * input_width + source_x
    return pixels.gather(indices, output_shape)

tensor<nat8> | error downsample_mean(tensor<nat8> pixels, int factor)
    if pixels.is_tracked()
        return error("vision.downsample_mean cannot operate on a tracked tensor; call untrack() explicitly", code = "VISION_TRACKED")
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.downsample_mean requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.downsample_mean requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if factor <= 0
        return error("vision.downsample_mean factor must be positive", code = "VISION_ARGUMENT")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    if factor > shape[height_axis] or factor > shape[width_axis]
        return error("vision.downsample_mean factor exceeds the image height or width", code = "VISION_ARGUMENT")
    if factor == 1
        return pixels

    output_shape := shape
    output_shape[height_axis] = shape[height_axis] / factor
    output_shape[width_axis] = shape[width_axis] / factor

    // Vision owns the CPU and Metal block-mean kernels. Where no Vision kernel
    // can run (other backends), the portable Vision composition stays on the
    // input device; a kernel failure is returned as an error.
    source := pixels
    if not source.is_contiguous()
        source = source.contiguous()
    native_output := internal.native_output<nat8>(output_shape, pixels.device())
    native_status := native.downsample_mean<nat8>(
        source, &native_output, int64(factor)
    )
    if native_status == 0
        return native_output
    if not internal.block_native_unavailable(native_status)
        return error(internal.block_native_problem(native_status), code = "VISION_NATIVE")
    return internal.block_mean_u8(source, factor)

tensor<T> | error downsample_mean<T: floating>(tensor<T> pixels, int factor)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.downsample_mean requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.downsample_mean requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if factor <= 0
        return error("vision.downsample_mean factor must be positive", code = "VISION_ARGUMENT")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    if factor > shape[height_axis] or factor > shape[width_axis]
        return error("vision.downsample_mean factor exceeds the image height or width", code = "VISION_ARGUMENT")
    if factor == 1
        return pixels

    output_shape := shape
    output_shape[height_axis] = shape[height_axis] / factor
    output_shape[width_axis] = shape[width_axis] / factor

    // Vision owns the CPU and Metal block-mean kernels and their autograd
    // (including backward(track = true)). A non-contiguous view is made
    // contiguous first; a tracked one through one graph-preserving gather,
    // because contiguous() requires untracked input. Where no Vision kernel
    // can run (other backends, oversized Metal dispatches) the portable
    // composition stays on the input device and keeps the graph; a kernel
    // failure or a dtype the device cannot compute at all (real64 on Metal)
    // is returned as an error.
    source := pixels
    if not source.is_contiguous()
        if source.is_tracked()
            source = internal.dense_copy<T>(source)
        else
            source = source.contiguous()
    native_output := internal.native_output<T>(output_shape, pixels.device())
    native_status := native.downsample_mean<T>(
        source, &native_output, int64(factor)
    )
    if native_status == 0
        return native_output
    if not internal.block_native_unavailable(native_status)
        return error(internal.block_native_problem(native_status), code = "VISION_NATIVE")
    return internal.block_mean<T>(source, factor)

tensor<T> | error flip_horizontal<T>(tensor<T> pixels)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.flip_horizontal requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.flip_horizontal requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    height := shape[height_axis]
    width := shape[width_axis]
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    count := planes * height * width
    int[] indices := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % width
        y := (flat_index / width) % height
        plane := flat_index / (height * width)
        indices[flat_index] = (plane * height + y) * width + (width - 1 - x)
    return pixels.gather(indices, shape)

tensor<T> | error flip_vertical<T>(tensor<T> pixels)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.flip_vertical requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.flip_vertical requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    height := shape[height_axis]
    width := shape[width_axis]
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    count := planes * height * width
    int[] indices := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % width
        y := (flat_index / width) % height
        plane := flat_index / (height * width)
        indices[flat_index] = (plane * height + (height - 1 - y)) * width + x
    return pixels.gather(indices, shape)

tensor<T> | error rotate90<T>(tensor<T> pixels)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.rotate90 requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.rotate90 requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    input_height := shape[height_axis]
    input_width := shape[width_axis]
    output_height := input_width
    output_width := input_height
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    output_shape := shape
    output_shape[height_axis] = output_height
    output_shape[width_axis] = output_width
    count := planes * output_height * output_width
    int[] indices := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % output_width
        y := (flat_index / output_width) % output_height
        plane := flat_index / (output_height * output_width)
        source_y := input_height - 1 - x
        source_x := y
        indices[flat_index] = (plane * input_height + source_y) * input_width + source_x
    return pixels.gather(indices, output_shape)

tensor<T> | error rotate180<T>(tensor<T> pixels)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.rotate180 requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.rotate180 requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    height := shape[height_axis]
    width := shape[width_axis]
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    count := planes * height * width
    int[] indices := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % width
        y := (flat_index / width) % height
        plane := flat_index / (height * width)
        indices[flat_index] = (plane * height + (height - 1 - y)) * width + (width - 1 - x)
    return pixels.gather(indices, shape)

tensor<T> | error rotate270<T>(tensor<T> pixels)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.rotate270 requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.rotate270 requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    input_height := shape[height_axis]
    input_width := shape[width_axis]
    output_height := input_width
    output_width := input_height
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    output_shape := shape
    output_shape[height_axis] = output_height
    output_shape[width_axis] = output_width
    count := planes * output_height * output_width
    int[] indices := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % output_width
        y := (flat_index / output_width) % output_height
        plane := flat_index / (output_height * output_width)
        source_y := x
        source_x := input_width - 1 - y
        indices[flat_index] = (plane * input_height + source_y) * input_width + source_x
    return pixels.gather(indices, output_shape)

tensor<nat8> | error grayscale(tensor<nat8> pixels)
    if pixels.is_tracked()
        return error("vision.grayscale cannot operate on a tracked tensor; call untrack() explicitly", code = "VISION_TRACKED")
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.grayscale requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.grayscale requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    channel_axis := int(len(shape)) - 3
    channels := shape[channel_axis]
    if channels != 1 and channels != 3 and channels != 4
        return error("vision.grayscale requires 1, 3, or 4 channels", code = "VISION_SHAPE")

    height := shape[int(len(shape)) - 2]
    width := shape[int(len(shape)) - 1]
    images := 1
    for 0 <= int axis < channel_axis
        images = images * shape[axis]
    output_count := images * height * width
    output_shape := shape
    output_shape[channel_axis] = 1

    int[] red_indices := array(nat(output_count), fill = 0)
    int[] green_indices := array(nat(output_count), fill = 0)
    int[] blue_indices := array(nat(output_count), fill = 0)
    for 0 <= int flat_index < output_count
        x := flat_index % width
        y := (flat_index / width) % height
        image_index := flat_index / (height * width)
        image_base := image_index * channels * height * width
        red_indices[flat_index] = image_base + y * width + x
        if channels != 1
            green_indices[flat_index] = image_base + height * width + y * width + x
            blue_indices[flat_index] = image_base + 2 * height * width + y * width + x

    values := int64(pixels)
    red := values.gather(red_indices, output_shape)
    if channels == 1
        return nat8(red)

    green := values.gather(green_indices, output_shape)
    blue := values.gather(blue_indices, output_shape)
    gray := (
        red * 299 + green * 587 + blue * 114 + 500
    ) / 1000
    return nat8(gray)

tensor<T> | error grayscale<T: floating>(tensor<T> pixels)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.grayscale requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.grayscale requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    channel_axis := int(len(shape)) - 3
    channels := shape[channel_axis]
    if channels != 1 and channels != 3 and channels != 4
        return error("vision.grayscale requires 1, 3, or 4 channels", code = "VISION_SHAPE")

    height := shape[int(len(shape)) - 2]
    width := shape[int(len(shape)) - 1]
    images := 1
    for 0 <= int axis < channel_axis
        images = images * shape[axis]
    output_count := images * height * width
    output_shape := shape
    output_shape[channel_axis] = 1

    int[] red_indices := array(nat(output_count), fill = 0)
    int[] green_indices := array(nat(output_count), fill = 0)
    int[] blue_indices := array(nat(output_count), fill = 0)
    for 0 <= int flat_index < output_count
        x := flat_index % width
        y := (flat_index / width) % height
        image_index := flat_index / (height * width)
        image_base := image_index * channels * height * width
        red_indices[flat_index] = image_base + y * width + x
        if channels != 1
            green_indices[flat_index] = image_base + height * width + y * width + x
            blue_indices[flat_index] = image_base + 2 * height * width + y * width + x

    red := pixels.gather(red_indices, output_shape)
    if channels == 1
        return red
    green := pixels.gather(green_indices, output_shape)
    blue := pixels.gather(blue_indices, output_shape)
    return (red * 299.0 + green * 587.0 + blue * 114.0) / 1000.0

tensor<T> | error threshold<T: floating>(
    tensor<T> pixels,
    T cutoff,
    T low := 0.0,
    T high := 1.0
)
    if pixels.is_tracked()
        return error("vision.threshold cannot operate on a tracked tensor; call untrack() explicitly", code = "VISION_TRACKED")
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.threshold requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.threshold requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")

    count := 1
    for dimension := shape[]
        count = count * dimension
    flat := pixels.reshape([nat(count)])
    result := flat * 0.0 + low
    for 0 <= int index < count
        if flat[index].item() >= cutoff
            result[index] = high
    return result.reshape(nat(shape))

tensor<nat8> | error threshold(
    tensor<nat8> pixels,
    nat8 cutoff,
    nat8 low := nat8(0),
    nat8 high := nat8(255)
)
    if pixels.is_tracked()
        return error("vision.threshold cannot operate on a tracked tensor; call untrack() explicitly", code = "VISION_TRACKED")
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.threshold requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.threshold requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")

    cutoff_value := int(cutoff)
    low_value := int(low)
    high_value := int(high)
    values := int64(pixels)
    mask_offset := int64(256 - cutoff_value)
    mask := (values + mask_offset) / 256
    low_scalar := int64(low_value)
    range_scalar := int64(high_value - low_value)
    result := low_scalar + mask * range_scalar
    return nat8(result)

tensor<T> | error blur<T: floating>(tensor<T> pixels, int radius := 1)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.blur requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.blur requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if radius < 0
        return error("vision.blur radius must be nonnegative", code = "VISION_ARGUMENT")
    if radius == 0
        return pixels

    height := shape[int(len(shape)) - 2]
    width := shape[int(len(shape)) - 1]
    effective_radius := radius
    max_radius := height - 1
    if width - 1 > max_radius
        max_radius = width - 1
    if effective_radius > max_radius
        effective_radius = max_radius

    side := effective_radius * 2 + 1
    kernel_count := side * side
    int[] kernel_indices := array(nat(kernel_count), fill = 0)
    ones := pixels * 0.0 + 1.0
    kernel := ones.gather(kernel_indices, [side, side])
    totals := internal.convolve2d(pixels, kernel, effective_radius)
    coverage := internal.convolve2d(ones, kernel, effective_radius)
    return totals / coverage

tensor<nat8> | error blur(tensor<nat8> pixels, int radius := 1)
    if pixels.is_tracked()
        return error("vision.blur cannot operate on a tracked tensor; call untrack() explicitly", code = "VISION_TRACKED")
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.blur requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.blur requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if radius < 0
        return error("vision.blur radius must be nonnegative", code = "VISION_ARGUMENT")
    if radius == 0
        return pixels

    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    height := shape[height_axis]
    width := shape[width_axis]
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    max_radius := height - 1
    if width - 1 > max_radius
        max_radius = width - 1
    effective_radius := radius
    if effective_radius > max_radius
        effective_radius = max_radius

    side := effective_radius * 2 + 1
    kernel_count := side * side
    values := int64(pixels)
    int[] kernel_indices := array(nat(kernel_count), fill = 0)
    kernel := values.gather(kernel_indices, [side, side])
    kernel = kernel * 0 + 1

    totals := internal.convolve2d(
        values, kernel, effective_radius
    )
    coverage_source := values * 0 + 1
    coverage := internal.convolve2d(
        coverage_source, kernel, effective_radius
    )

    count := planes * height * width
    flat_totals := totals.reshape([nat(count)])
    flat_coverage := coverage.reshape([nat(count)])
    for 0 <= int index < count
        flat_totals[index] = flat_totals[index].item() / flat_coverage[index].item()

    converted := try nat8(flat_totals)
    return converted.reshape(nat(shape))

tensor<T> | error filter<T: floating, K: floating>(
    tensor<T> pixels,
    tensor<K> kernel,
    K divisor := 1.0,
    K offset := 0.0
)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.filter requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.filter requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if divisor == 0.0
        return error("vision.filter divisor must not be zero", code = "VISION_ARGUMENT")
    kernel_shape := int(kernel.shape())
    if len(kernel_shape) != 2
        return error("vision.filter requires a rank-2 kernel", code = "VISION_SHAPE")
    if kernel_shape[0] <= 0 or kernel_shape[1] <= 0
        return error("vision.filter requires positive kernel dimensions", code = "VISION_SHAPE")

    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    height := shape[height_axis]
    width := shape[width_axis]
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    kernel_height := kernel_shape[0]
    kernel_width := kernel_shape[1]
    center_y := kernel_height / 2
    center_x := kernel_width / 2
    padding := center_y
    if center_x > padding
        padding = center_x

    kernel_count := kernel_height * kernel_width
    int[] kernel_indices := array(nat(kernel_count), fill = 0)
    for 0 <= int flat_index < kernel_count
        x := flat_index % kernel_width
        y := flat_index / kernel_width
        kernel_indices[flat_index] = (
            (kernel_height - 1 - y) * kernel_width
            + kernel_width - 1 - x
        )
    typed_kernel := kernel
    typed_divisor := divisor
    typed_offset := offset
    flipped_kernel := typed_kernel.gather(
        kernel_indices, [kernel_height, kernel_width]
    )
    expanded := internal.convolve2d(pixels, flipped_kernel, padding)
    expanded_shape := int(expanded.shape())
    expanded_height := expanded_shape[height_axis]
    expanded_width := expanded_shape[width_axis]
    crop_top := padding - center_y
    crop_left := padding - center_x
    input_count := planes * height * width
    int[] filtered_indices := array(nat(input_count), fill = 0)
    for 0 <= int flat_index < input_count
        x := flat_index % width
        remaining := flat_index / width
        y := remaining % height
        plane := remaining / height
        filtered_indices[flat_index] = (
            (plane * expanded_height + crop_top + y) * expanded_width
            + crop_left + x
        )
    filtered := expanded.gather(filtered_indices, shape)
    return filtered / typed_divisor + typed_offset

tensor<nat8> | error filter(
    tensor<nat8> pixels,
    tensor<int64> kernel,
    int divisor := 1,
    int offset := 0
)
    if pixels.is_tracked()
        return error("vision.filter cannot operate on a tracked tensor; call untrack() explicitly", code = "VISION_TRACKED")
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.filter requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.filter requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if divisor == 0
        return error("vision.filter divisor must not be zero", code = "VISION_ARGUMENT")
    kernel_shape := int(kernel.shape())
    if len(kernel_shape) != 2
        return error("vision.filter requires a rank-2 kernel", code = "VISION_SHAPE")
    if kernel_shape[0] <= 0 or kernel_shape[1] <= 0
        return error("vision.filter requires positive kernel dimensions", code = "VISION_SHAPE")

    // Vision owns the CPU nat8 filter kernel. Unsupported layout/device cases
    // fall through to the portable Vision implementation below.
    native_output := tensor.zeros<nat8>(nat(shape))
    native_status := native.filter_u8(
        pixels, kernel, &native_output, int64(divisor), int64(offset)
    )
    if native_status == 0
        return native_output

    height_axis := int(len(shape)) - 2
    width_axis := int(len(shape)) - 1
    height := shape[height_axis]
    width := shape[width_axis]
    planes := 1
    for 0 <= int axis < height_axis
        planes = planes * shape[axis]
    kernel_height := kernel_shape[0]
    kernel_width := kernel_shape[1]
    center_y := kernel_height / 2
    center_x := kernel_width / 2
    padding := center_y
    if center_x > padding
        padding = center_x

    values := int64(pixels)
    kernel_count := kernel_height * kernel_width
    int[] kernel_indices := array(nat(kernel_count), fill = 0)
    for 0 <= int flat_index < kernel_count
        x := flat_index % kernel_width
        y := flat_index / kernel_width
        kernel_indices[flat_index] = (
            (kernel_height - 1 - y) * kernel_width
            + kernel_width - 1 - x
        )
    flipped_kernel := kernel.gather(
        kernel_indices, [kernel_height, kernel_width]
    )
    expanded := internal.convolve2d(
        values, flipped_kernel, padding
    )
    expanded_shape := int(expanded.shape())
    expanded_height := expanded_shape[height_axis]
    expanded_width := expanded_shape[width_axis]
    crop_top := padding - center_y
    crop_left := padding - center_x
    input_count := planes * height * width
    int[] filtered_indices := array(nat(input_count), fill = 0)
    for 0 <= int flat_index < input_count
        x := flat_index % width
        remaining := flat_index / width
        y := remaining % height
        plane := remaining / height
        filtered_indices[flat_index] = (
            (plane * expanded_height + crop_top + y) * expanded_width
            + crop_left + x
        )
    filtered := expanded.gather(filtered_indices, shape)
    result_shape := int(filtered.shape())

    flat := filtered.reshape([nat(input_count)])
    for 0 <= int index < input_count
        adjusted := flat[index].item() / divisor + offset
        if adjusted < 0
            adjusted = 0
        if adjusted > 255
            adjusted = 255
        flat[index] = int64(adjusted)

    converted := try nat8(flat)
    return converted.reshape(nat(result_shape))

tensor<T> | error dilate<T>(tensor<T> pixels, radius := 1)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.dilate requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.dilate requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if radius < 0
        return error("vision.dilate radius must be nonnegative", code = "VISION_ARGUMENT")

    height := shape[int(len(shape)) - 2]
    width := shape[int(len(shape)) - 1]
    count := 1
    for dimension := shape[]
        if count > 9223372036854775807 / dimension
            return error("vision.dilate tensor shape is too large", code = "VISION_SIZE")
        count = count * dimension

    int[] flat_indices := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        flat_indices[flat_index] = flat_index
    flat := pixels.gather(flat_indices, [count])

    horizontal_radius := radius
    if horizontal_radius > width - 1
        horizontal_radius = width - 1
    horizontal_width := horizontal_radius * 2 + 1
    if count > 9223372036854775807 / horizontal_width
        return error("vision.dilate horizontal workspace is too large", code = "VISION_SIZE")
    int[] horizontal_indices := array(nat(count * horizontal_width), fill = 0)
    int[] selected := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % width
        remaining := flat_index / width
        y := remaining % height
        plane := remaining / height
        center := (plane * height + y) * width + x
        selected[flat_index] = flat_index * horizontal_width
        for 0 <= int offset < horizontal_width
            source_x := x + offset - horizontal_radius
            source := center
            if source_x >= 0 and source_x < width
                source = (plane * height + y) * width + source_x
            horizontal_indices[flat_index * horizontal_width + offset] = source

    horizontal_windows := flat.gather(
        horizontal_indices,
        [count, horizontal_width]
    )
    horizontal_extrema := math.max_last<T>(horizontal_windows)
    horizontal := horizontal_extrema.gather(selected, [count])

    vertical_radius := radius
    if vertical_radius > height - 1
        vertical_radius = height - 1
    vertical_width := vertical_radius * 2 + 1
    if count > 9223372036854775807 / vertical_width
        return error("vision.dilate vertical workspace is too large", code = "VISION_SIZE")
    int[] vertical_indices := array(nat(count * vertical_width), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % width
        remaining := flat_index / width
        y := remaining % height
        plane := remaining / height
        center := (plane * height + y) * width + x
        selected[flat_index] = flat_index * vertical_width
        for 0 <= int offset < vertical_width
            source_y := y + offset - vertical_radius
            source := center
            if source_y >= 0 and source_y < height
                source = (plane * height + source_y) * width + x
            vertical_indices[flat_index * vertical_width + offset] = source

    vertical_windows := horizontal.gather(
        vertical_indices,
        [count, vertical_width]
    )
    vertical_extrema := math.max_last<T>(vertical_windows)
    return vertical_extrema.gather(selected, [count]).reshape(nat(shape))

tensor<T> | error erode<T>(tensor<T> pixels, radius := 1)
    shape := int(pixels.shape())
    if len(shape) < 3
        return error("vision.erode requires rank >= 3 with trailing C, H, W dimensions", code = "VISION_SHAPE")
    for dimension := shape[]
        if dimension <= 0
            return error("vision.erode requires positive (..., C, H, W) dimensions", code = "VISION_SHAPE")
    if radius < 0
        return error("vision.erode radius must be nonnegative", code = "VISION_ARGUMENT")

    height := shape[int(len(shape)) - 2]
    width := shape[int(len(shape)) - 1]
    count := 1
    for dimension := shape[]
        if count > 9223372036854775807 / dimension
            return error("vision.erode tensor shape is too large", code = "VISION_SIZE")
        count = count * dimension

    int[] flat_indices := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        flat_indices[flat_index] = flat_index
    flat := pixels.gather(flat_indices, [count])

    horizontal_radius := radius
    if horizontal_radius > width - 1
        horizontal_radius = width - 1
    horizontal_width := horizontal_radius * 2 + 1
    if count > 9223372036854775807 / horizontal_width
        return error("vision.erode horizontal workspace is too large", code = "VISION_SIZE")
    int[] horizontal_indices := array(nat(count * horizontal_width), fill = 0)
    int[] selected := array(nat(count), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % width
        remaining := flat_index / width
        y := remaining % height
        plane := remaining / height
        center := (plane * height + y) * width + x
        selected[flat_index] = flat_index * horizontal_width
        for 0 <= int offset < horizontal_width
            source_x := x + offset - horizontal_radius
            source := center
            if source_x >= 0 and source_x < width
                source = (plane * height + y) * width + source_x
            horizontal_indices[flat_index * horizontal_width + offset] = source

    horizontal_windows := flat.gather(
        horizontal_indices,
        [count, horizontal_width]
    )
    horizontal_extrema := math.min_last<T>(horizontal_windows)
    horizontal := horizontal_extrema.gather(selected, [count])

    vertical_radius := radius
    if vertical_radius > height - 1
        vertical_radius = height - 1
    vertical_width := vertical_radius * 2 + 1
    if count > 9223372036854775807 / vertical_width
        return error("vision.erode vertical workspace is too large", code = "VISION_SIZE")
    int[] vertical_indices := array(nat(count * vertical_width), fill = 0)
    for 0 <= int flat_index < count
        x := flat_index % width
        remaining := flat_index / width
        y := remaining % height
        plane := remaining / height
        center := (plane * height + y) * width + x
        selected[flat_index] = flat_index * vertical_width
        for 0 <= int offset < vertical_width
            source_y := y + offset - vertical_radius
            source := center
            if source_y >= 0 and source_y < height
                source = (plane * height + source_y) * width + x
            vertical_indices[flat_index * vertical_width + offset] = source

    vertical_windows := horizontal.gather(
        vertical_indices,
        [count, vertical_width]
    )
    vertical_extrema := math.min_last<T>(vertical_windows)
    return vertical_extrema.gather(selected, [count]).reshape(nat(shape))

