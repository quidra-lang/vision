import vision

int | error transform_image(tensor<uint8> pixels)
    tensor<uint8> resized = try vision.resize(
        pixels, height = 256, width = 256
    )
    tensor<uint8> grayscale = try vision.grayscale(resized)
    tensor<uint8> edges = try vision.threshold(
        grayscale, cutoff = uint8(128)
    )
    auto | error written = vision.write("output.png", edges)
    match written
        void
            print("saved")
            print(NL)
        error problem
            return problem
    return 0

tensor<uint8> | error loaded = vision.read<uint8>("input.png")
match loaded
    tensor<uint8> pixels
        auto | error transformed = transform_image(pixels)
        match transformed
            int
                int ignored = transformed
            error problem
                print(problem)
                print(NL)
    error problem
        print(problem)
        print(NL)
