import vision

int | error transform_image(tensor<nat8> pixels)
    tensor<nat8> resized = try vision.resize(
        pixels, height = 256, width = 256
    )
    tensor<nat8> grayscale = try vision.grayscale(resized)
    tensor<nat8> edges = try vision.threshold(
        grayscale, cutoff = nat8(128)
    )
    auto | error written = vision.write("output.png", edges)
    match written
        void
            print("saved")
            print(NL)
        error problem
            return problem
    return 0

tensor<nat8> | error loaded = vision.read<nat8>("input.png")
match loaded
    tensor<nat8> pixels
        auto | error transformed = transform_image(pixels)
        match transformed
            int
                int ignored = transformed
            error problem
                print(problem)
                print(NL)
    error problem
        print(problem)
        print(NL)
