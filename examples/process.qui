import vision

int | error process(tensor<uint8> pixels)
    tensor<uint8> resized = try vision.resize(
        pixels, height = 256, width = 256
    )
    tensor<uint8> grayscale = try vision.grayscale(resized)
    tensor<uint8> edges = try vision.threshold(
        grayscale, cutoff = uint8(128)
    )
    auto written = image.write("output.png", edges)
    match written
        void
            print("saved")
        error problem
            return problem
    return 0

tensor<uint8> | error loaded = image.read("input.png")
match loaded
    tensor<uint8> pixels
        auto processed = process(pixels)
        match processed
            int
                int ignored = processed
            error problem
                print(problem)
    error problem
        print(problem)
