name = vision
version = 0.5.0
repository = https://github.com/quidra-lang/vision
native.source.codecs = native/image_codec.cpp
native.source.cpu = native/vision_native.cpp
native.source.macos-arm64.metal = native/vision_metal.mm
native.source.macos-x86_64.metal = native/vision_metal.mm
native.pkg.jpeg = libjpeg
native.pkg.png = libpng
native.pkg.tiff = libtiff-4
native.pkg.webp = libwebp
requires.quidra = >=0.5.0 <0.6.0
requires.math = >=0.5.0 <0.6.0
